{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.sf32lb52-settings",
  "name": "sf32lb52-settings",
  "title": "SF32LB52 Settings",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ]
    }
  },
  "app": {
    "entry": "apps/settings/main.tsx",
    "output": "sf32lb52-settings",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          466,
          466
        ],
        "presentation": "native"
      }
    }
  }
}
